server:
  host: 0.0.0.0
  port: 8080

providers:
  - name: openai
    type: openai-compatible
    base_url: https://api.openai.com/v1
    api_key_env: OPENAI_API_KEY
    models: ["gpt-*"]

  - name: ollama
    type: ollama
    # Local dev: Ollama on the same machine. Docker Compose: use http://ollama:11434
    base_url: http://127.0.0.1:11434
    models: ["llama*", "mistral*", "qwen*"]

# Optional: load named policy presets (see presets/developer.yaml, presets/child.yaml)
# presets:
#   - developer
#   - child

policies:
  - name: block-secrets
    when: input.contains_secret
    action: block

  # Alternative: mask secrets and forward instead of blocking
  # - name: redact-secrets
  #   when: input.contains_secret
  #   action: redact

  - name: warn-large-cost
    when: estimated_cost > 1.00
    action: warn

logging:
  store: sqlite:///data/aiwall.db
  log_raw_prompts: false
  retention_days: 90

pricing:
  file: prices.yaml

scanners:
  ignore_examples: true
  entropy:
    enabled: true
    min_length: 20
    threshold: 4.5
  dotenv:
    enabled: true
    min_lines: 2
    min_value_length: 8
    pasted_file_min_lines: 5
  allowlist:
    literals: []
    patterns: []
  # Per-rule overrides (enabled, min_length). Example:
  # rules:
  #   jwt:
  #     enabled: false
  #   generic-api-key:
  #     min_length: 24
  rules: {}

# Optional: require clients to present an AIWall-issued API key (off by default).
# gateway_auth:
#   enabled: true
#   api_key_env: AIWALL_API_KEY

# Optional: alert channels
# Quote the "on" key — unquoted `on:` is a YAML boolean.
# alerts:
#   - channel: stub
#     "on": [secret_blocked, policy_blocked]
#   - channel: telegram
#     bot_token_env: TELEGRAM_BOT_TOKEN
#     chat_id: "123456789"
#     "on": [secret_blocked, policy_blocked, daily_limit]
#   - channel: webhook
#     url: https://ha.local/api/webhook/aiwall
#     "on": [secret_blocked, policy_blocked]
#   - channel: ntfy
#     topic: aiwall-alerts
#     # server: https://ntfy.home.local
#     "on": [secret_blocked, policy_blocked, provider_error]

# Optional: probe upstream providers and alert on outage (uses provider_error).
# Point an alert channel at provider_error. Monitor AIWall itself via GET /healthz.
# heartbeat:
#   enabled: true
#   interval_seconds: 60

# Optional: agent shell/file guardrails (Phase 5). Off by default.
# Scores come from the command risk engine (rm -rf / is critical, ls is low).
# Sensitive paths (.env, SSH keys, cloud creds, etc.) use file.action.
# Critical actions are held until approve/deny (or approval_timeout_seconds).
# agent_guardrails:
#   enabled: true
#   approval_timeout_seconds: 60
#   shell:
#     warn_above: 40
#     block_above: 70
#     require_approval_above: 90
#   file:
#     action: block   # block | warn | require_approval

# Optional: browser CORS for Open WebUI Direct Connections.
# cors:
#   enabled: true
#   allow_origins:
#     - "http://localhost:3000"
#     - "http://127.0.0.1:3000"
