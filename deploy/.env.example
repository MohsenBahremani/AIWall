# Copy to the repo root as `.env` (gitignored) or export before `docker compose up`.
# scripts/demo.sh and scripts/dev.sh load this file automatically when present.

# Host port AIWall listens on (also passed into the container).
AIWALL_PORT=8080

# Path inside the container; override by bind-mounting a different file to /app/aiwall.yaml.
# AIWALL_CONFIG=/app/aiwall.yaml

# --- Upstream API keys (only needed for the providers you uncomment in aiwall.yaml) ---
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...          # if your OpenAI-compatible relay expects this name
# CURSOR_API_KEY=...

# AIWall gateway API key (required when gateway_auth.enabled is true).
# Used as Open WebUI's server-side bootstrap key in the family compose stack.
# AIWALL_API_KEY=your-aiwall-key

# --- Model names used by scripts/demo.sh (and curl examples) ---
# Prefer setting these instead of hardcoding model ids in shell scripts.
# AIWALL_DEMO_MODEL overrides auto-detection entirely.
# AIWALL_DEMO_MODEL=llama3.2:1b
# AIWALL_OLLAMA_MODEL=llama3.2:1b
# AIWALL_OPENAI_MODEL=gpt-4o-mini
# AIWALL_CLAUDE_MODEL=anthropic/claude-3.5-sonnet
# AIWALL_CURSOR_MODEL=composer-2.5

# Demo secret sample (fake; used only by scripts/demo.sh block path).
# AIWALL_DEMO_SECRET=AKIADEMOAIWALLTEST01

# Lab base URL when AIWall is not on localhost:8080.
# AIWALL_BASE_URL=http://127.0.0.1:8080

# Host port for Open WebUI (family reference stack).
# OPEN_WEBUI_PORT=3000

# Host port for Ollama when using --profile ollama
# OLLAMA_PORT=11434
# OLLAMA_URL=http://127.0.0.1:11434
